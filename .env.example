# ─────────────────────────────────────────────────────────────
# TillmanBuildsTech.com — environment variables
# Copy to .env for local dev, and set the same values in Vercel
# (Settings → Environment Variables) for preview + production.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, OG tags.
PUBLIC_SITE_URL=https://tillmanbuildstech.com

# Social links — rendered into the site at build time.
PUBLIC_GITHUB_URL=https://github.com/TillmanBuildsTech
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/tillman-brandon/
PUBLIC_BLOG_URL=https://brandontillman.com

# Server-only — NEVER prefix these with PUBLIC_ (they'd be exposed
# to the browser). Set them in Vercel only.
# Odoo API key (Odoo → Preferences → API Keys). The contact form and
# newsletter both create crm.lead records. REQUIRED — without it the
# /api/contact and /api/subscribe routes return 500 "Server misconfiguration."
ODOO_API_KEY=your-odoo-api-key
# Optional overrides — default to the TBT Odoo instance.
ODOO_URL=https://odoo.tillmanbuildstech.com
ODOO_DB=tbt-odoo-test
ODOO_USER=brandon@tillmanbuildstech.com

# Optional — best-effort founder notification email on contact inquiries.
# Skipped entirely when RESEND_API_KEY is unset (the lead is already in Odoo).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@tillmanbuildstech.com
