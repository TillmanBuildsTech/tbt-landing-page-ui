---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FooterBar from '../components/FooterBar.astro';
import { Image } from 'astro:assets';
import brandonTillmanImage from '../images/brandon-tillman.png';
// import brandonTillmanImage from '../images/brandon-tillman-tbt.png';
import { MAX_MESSAGE_LENGTH } from '../lib/api';
---

<BaseLayout>
  <Nav />

  <!-- ──────────────────────────────────────────────────────────────
       HERO
  ────────────────────────────────────────────────────────────────── -->
  <section class="hero" aria-label="Hero — introduction">
    <div id="glyph-lattice" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__left">
        <p class="hero__kicker">// Solo Expert</p>
        <h1 class="hero__headline" data-pretext>
		   I solve the complex problems your teams never get to
        </h1>
        <p class="hero__sub">Independent consultant with enterprise depth</p>
        <p class="hero__desc">AI · Automation · Infrastructure · DevOps</p>
        <div class="hero__ctas">
          <a href="#contact" class="btn-primary">$ start_a_project</a>
          <a href="/projects" class="btn-ghost">View my projects →</a>
        </div>
      </div>

      <div class="hero__terminal" role="region" aria-label="Terminal — capabilities">
        <div class="terminal__chrome">
          <div class="terminal__dots" aria-hidden="true">
            <span class="terminal__dot terminal__dot--red"></span>
            <span class="terminal__dot terminal__dot--yellow"></span>
            <span class="terminal__dot terminal__dot--green"></span>
          </div>
          <span class="terminal__title">brandon@TillmanBuildsTech ~ zsh</span>
          <span style="width:52px"></span>
        </div>
        <div class="terminal__body" id="terminal-body" aria-live="polite">
          <!-- typed by JS -->
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────
       SERVICES
  ────────────────────────────────────────────────────────────────── -->
  <section class="services" id="services" aria-labelledby="services-heading">
    <div class="container">
      <p class="section-label" id="services-heading">// Services</p>
      <div class="services__grid">

        <article class="service-card">
          <span class="service-card__num">01</span>
          <h3 class="service-card__name">AI &amp; Agents</h3>
          <p class="service-card__desc" data-pretext>
            Custom LLM integrations, autonomous agents, RAG pipelines, and production eval frameworks. OpenAI, Anthropic, or open-weight models.
          </p>
          <span class="service-card__tag">ai_agents/</span>
          <a href="/services/ai-agents" class="service-card__link">Read more →</a>
        </article>

        <article class="service-card">
          <span class="service-card__num">02</span>
          <h3 class="service-card__name">Automation</h3>
          <p class="service-card__desc" data-pretext>
            End-to-end workflow automation replacing manual ops: n8n, Make, Python scripts, and custom API integrations that actually stay running.
          </p>
          <span class="service-card__tag">automation/</span>
          <a href="/services/automation" class="service-card__link">Read more →</a>
        </article>

        <article class="service-card">
          <span class="service-card__num">03</span>
          <h3 class="service-card__name">Web &amp; Apps</h3>
          <p class="service-card__desc" data-pretext>
            Fast, purpose-built web apps and internal tools. React, Next.js, Node. Emphasis on performance and developer handoff quality.
          </p>
          <span class="service-card__tag">web_apps/</span>
          <a href="/services/web-apps" class="service-card__link">Read more →</a>
        </article>

        <article class="service-card">
          <span class="service-card__num">04</span>
          <h3 class="service-card__name">DevOps</h3>
          <p class="service-card__desc" data-pretext>
            Infrastructure setup, containerization, CI/CD pipelines, and cloud deployments. From zero to production-ready with monitoring.
          </p>
          <span class="service-card__tag">devops/</span>
          <a href="/services/devops" class="service-card__link">Read more →</a>
        </article>

      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────
       BIO / TRUST STRIP
  ────────────────────────────────────────────────────────────────── -->
  <section class="bio" id="about" aria-labelledby="bio-heading">
    <div class="container">
      <div class="bio__inner">

        <div class="bio__left">
          <div class="bio__avatar">
            <Image src={brandonTillmanImage} alt="Brandon Tillman" width={112} height={112} />
          </div>
          <div class="bio__content">
            <h2 class="bio__name" id="bio-heading">Brandon Tillman</h2>
            <p class="bio__role">Independent Consultant</p>
            <p class="bio__text" data-pretext>
              I'm a solo expert with 15+ years building systems at scale — from enterprise infrastructure to AI-driven automation. I solve the problems that require deep expertise: complex deployments, production systems, infrastructure challenges. Not agencies. Not juniors. Just me, thorough work, and systems that actually work.
            </p>
            <div class="bio__links">
              <a href="https://brandontillman.com" class="bio__link" target="_blank" rel="noopener noreferrer" aria-label="Personal blog">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-.003 22C6.477 22 .997 16.523.997 11.997S6.477 2 .997 2s10.998-.001 10.998-.001c5.525 0 10.002 4.477 10.002 9.999s-4.477 10.001-10.002 10.001z"/></svg>
                Tech Blog
              </a>
              <a href="https://github.com/Tillman32" class="bio__link" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                GitHub
              </a>
			        <a href="https://www.linkedin.com/in/brandon-tillman/" class="bio__link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.268c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.268h-3v-5.604c0-1.337-.026-3.062-1.867-3.062s-2.154 1.459-2.154 2.965v5.701h-3v-10h2.881v1.367h.041c.401-.761 1.381-1.562 2.846-1.562 3.042 0 3.603 2.001 3.603 4.599v5.596z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>

        <div class="bio__stats" aria-label="Key stats">
          <div>
            <div class="bio__stat-num">15+</div>
            <div class="bio__stat-label">Years building at scale</div>
          </div>
          <div>
            <div class="bio__stat-num">Enterprise</div>
            <div class="bio__stat-label">Problems solved solo</div>
          </div>
          <div>
            <div class="bio__stat-num">Open source</div>
            <div class="bio__stat-label">Infrastructure tools</div>
          </div>
          <div style="margin-top: auto; padding-top: var(--space-4);">
            <a href="/about" class="bio__read-more">Read more →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ──────────────────────────────────────────────────────────────
       CONTACT + FOOTER CTA
  ────────────────────────────────────────────────────────────────── -->
  <section class="contact" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact__grid">

        <div>
          <h2 class="contact__headline" id="contact-heading">Let's solve it together.</h2>
          <p class="contact__sub">Tell me about your hard problem. I'll review it thoroughly and let you know if it's the right fit.</p>
          <form id="contact-form" method="POST" action="/api/contact" novalidate aria-label="Contact form">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Name</label>
                <input class="form-input" type="text" id="name" name="name" placeholder="Jane Smith" autocomplete="name" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input class="form-input" type="email" id="email" name="email" placeholder="jane@company.com" autocomplete="email" required />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="project-type">Project Type</label>
              <select class="form-select" id="project-type" name="project_type">
                <option value="">Select a category...</option>
                <option value="ai-agents">AI &amp; Agents</option>
                <option value="automation">Automation</option>
                <option value="web-apps">Web &amp; Apps</option>
                <option value="devops">DevOps &amp; Infrastructure</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="message">Message</label>
              <textarea class="form-textarea" id="message" name="message" placeholder="What's the hard problem you're trying to solve?" rows="4" maxlength={MAX_MESSAGE_LENGTH} required></textarea>
              <div class="form-hint" id="message-count" aria-live="polite">0 / {MAX_MESSAGE_LENGTH}</div>
            </div>
            <div class="hp-field" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn-submit">$ send_message</button>
            <div id="form-status" role="alert" aria-live="polite" style="margin-top: 12px; font-family: var(--font-mono); font-size: 13px;"></div>
          </form>
        </div>

        <div>
          <h3 class="newsletter__headline">Deep dives, not noise.</h3>
          <p class="newsletter__sub">Occasional writing on hard infrastructure problems, AI at scale, and things I build. Substance only.</p>
          <form id="newsletter-form" class="newsletter__form" method="POST" action="/api/subscribe" aria-label="Newsletter subscribe">
            <div class="hp-field" aria-hidden="true">
              <label for="newsletter-website">Website</label>
              <input type="text" id="newsletter-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input class="newsletter__input" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
            <button type="submit" class="btn-subscribe">subscribe →</button>
          </form>
          <div id="newsletter-status" role="alert" aria-live="polite" style="margin-top: 8px; font-family: var(--font-mono); font-size: 12px;"></div>

          <p class="quick-links__label">// Quick Links</p>
          <ul class="quick-links__list" role="list">
            <li><a href="#services">Services</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="https://brandontillman.com" target="_blank" rel="noopener noreferrer">Writing</a></li>
            <li><a href="https://github.com/Tillman32" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <FooterBar />

  <script>
    import '../scripts/main.js';
  </script>
</BaseLayout>
