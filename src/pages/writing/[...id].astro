---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FooterBar from '../../components/FooterBar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Nav />

  <main class="post-page">
    <div class="container">
      <a href="/writing" class="back-link">← Writing</a>

      <article>
        <header class="post-header">
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          <h1 class="post-title">{post.data.title}</h1>
          <time class="post-date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
        </header>

        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="post-hero"
            loading="lazy"
          />
        )}

        <div class="post-body">
          <Content />
        </div>
      </article>
    </div>
  </main>

  <FooterBar />
</BaseLayout>

<style>
  .post-page {
    padding-top: calc(56px + var(--space-8));
    padding-bottom: var(--space-16);
    min-height: 100vh;
  }

  .post-page .container {
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    margin-bottom: var(--space-4);
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    background: var(--border);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: var(--space-2);
  }

  .post-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .post-hero {
    width: 100%;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    margin-top: var(--space-4);
  }

  /* ─── Prose styles ───────────────────────────────────────────── */
  .post-body {
    font-family: var(--font-body);
    color: var(--text);
  }

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    font-family: var(--font-display);
    color: var(--text);
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .post-body :global(h2) { font-size: 1.75rem; }
  .post-body :global(h3) { font-size: 1.375rem; }
  .post-body :global(h4) { font-size: 1.125rem; }

  .post-body :global(p) {
    font-family: var(--font-body);
    color: var(--text);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .post-body :global(a:hover) {
    text-decoration: underline;
  }

  .post-body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .post-body :global(em) {
    font-style: italic;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--border);
    color: var(--text);
    border-radius: var(--radius-sm);
    padding: 0.15em 0.4em;
  }

  .post-body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    font-family: var(--font-body);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .post-body :global(li) {
    line-height: 1.75;
    margin-bottom: 0.35rem;
  }

  .post-body :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .post-body :global(th) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--surface);
  }

  @media (max-width: 768px) {
    .post-page {
      padding-top: calc(56px + var(--space-5));
    }
  }
</style>
